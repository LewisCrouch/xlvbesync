{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start VBA Watcher",
      "type": "shell",
      "command": "xlvbesync",
      "args": ["watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "xlvbesync",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(ERROR|WARN)\\s+(.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^watching\\b",
          "endsPattern": "^(ready|synced|up-to-date)\\b"
        }
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Extract VBA",
      "type": "shell",
      "command": "xlvbesync",
      "args": ["extract"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Inject VBA",
      "type": "shell",
      "command": "xlvbesync",
      "args": ["inject"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Reload Add-in (swap)",
      "type": "shell",
      "command": "xlvbesync",
      "args": ["reload"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Doctor",
      "type": "shell",
      "command": "xlvbesync",
      "args": ["doctor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
