# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- xlvba runtime state ----
.xlvba-state.json
*.xlvba.log

# ---- Excel lock / owner files ----
# Created by Excel while a workbook or add-in is open.
~$*.xls*
~$*.xlam
~$*.xlsm
~$*.xlsb

# ---- Excel autorecover / backup ----
*.xlk
*.xlb

# ---- Temp staging files produced during xlam swap-reload ----
*.tmp
*.xlvba-tmp
*.xlvba-bak
*.xlvba-stage.*
*.xlam.new
*.xlam.old
*.xlsm.new
*.xlsm.old

# ---- Scratch sandbox (generated by smoke tests) ----
sandbox/

# ---- Your project config and extracted VBA ----
# This repo ships the *tool*. Your xlvba.json holds machine-specific paths and
# src/ holds VBA belonging to your workbooks, so neither is committed here.
# Using this repo to version your own VBA? Delete these two lines.
/xlvba.json
/src/

# ---- OS metadata ----
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---- Editor noise ----
*.swp
*.swo
*~
.idea/
